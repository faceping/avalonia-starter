<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-ios</TargetFramework>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <!-- Change this to your own bundle id before you build your own app from this starter. -->
    <ApplicationId>com.example.facecheck.avalonia</ApplicationId>
    <ApplicationTitle>FaceCheck</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.iOS" Version="12.1.4" />
    <ProjectReference Include="..\FaceCheck\FaceCheck.csproj" />
    <PackageReference Include="FacePing.Sdk.Avalonia" Version="1.0.0-preview.5" />
  </ItemGroup>

</Project>
